# ─────────────────────────────────────────────────────────────────────────────
# .env.example — TrainConcierge Docker / local environment template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   cp .env.example .env
#   Edit .env with real values.
#   NEVER commit .env to version control — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Root password for the MySQL container (only used by Docker Compose init)
MYSQL_ROOT_PASSWORD=change_me_root_password

# Application database credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=train_concierge
DB_USERNAME=tc_user
DB_PASSWORD=change_me_strong_password

# ── JPA DDL ───────────────────────────────────────────────────────────────────
# update   → creates/alters tables automatically (safe for dev/staging)
# validate → validates only (use in production with Flyway/Liquibase)
# none     → no schema management
DDL_AUTO=update

# ── Server ────────────────────────────────────────────────────────────────────
APP_PORT=8080

# ── Spring Profile ────────────────────────────────────────────────────────────
# docker → uses application-docker.properties
# local  → plain local MySQL (no Docker)
SPRING_PROFILES_ACTIVE=docker

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Must be at least 256 bits (32 bytes) for HMAC-SHA256 signing.
JWT_SECRET=replace_with_64_char_minimum_random_base64_secret_key_never_use_this
JWT_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins for the React frontend (comma-separated, no trailing slash)
# Development:  http://localhost:3000
# Production:   https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Monitoring Scheduler ──────────────────────────────────────────────────────
MONITORING_ENABLED=true
MONITORING_INTERVAL_MS=30000
SEAT_ALERT_POLL_MS=60000

# ── Disruption Detection Rules ────────────────────────────────────────────────
DISRUPTION_MIN_DELAY_MINUTES=15
DISRUPTION_MEDIUM_DELAY_MINUTES=15
DISRUPTION_HIGH_DELAY_MINUTES=60

# ── Recommendation Engine Weights ─────────────────────────────────────────────
RECOMMENDATION_WEIGHT_ARRIVAL=0.35
RECOMMENDATION_WEIGHT_DURATION=0.25
RECOMMENDATION_WEIGHT_FARE=0.20
RECOMMENDATION_WEIGHT_SEATS=0.20
RECOMMENDATION_MIN_SEATS=1

# ── Travel Coordination Buffers ───────────────────────────────────────────────
COORDINATION_HOTEL_BUFFER_MINUTES=45
COORDINATION_CAB_BUFFER_MINUTES=15
