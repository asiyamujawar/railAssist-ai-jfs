        }
      ]
    },

    {
      "name": "18 — Admin — Simulation Control [ADMIN][SIMULATED]",
      "description": "High-level Phase 19 simulation control endpoints. Run in the following order for a complete demo:\n1. Clear Cache\n2. First Monitoring Cycle (seed cache)\n3. Trigger Delay\n4. Trigger Disruption Evaluation\n5. (Optionally) Second Monitoring Cycle\n6. Restore Normal\n7. Clear Cache (reset for next run)",
      "item": [
        {
          "name": "Step 1 — Clear Monitoring Cache",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/monitoring-cache", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","monitoring-cache"] }
          }
        },
        {
          "name": "Step 2 — Trigger Monitoring Cycle (Seed Cache)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/monitoring-cycle", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","monitoring-cycle"] }
          }
        },
        {
          "name": "Step 3 — Trigger Train Delay",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/trigger-delay", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","trigger-delay"] },
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"delayMinutes\": 120,\n  \"reason\": \"Signal failure at junction — all services halted.\"\n}" }
          }
        },
        {
          "name": "Step 4 — Trigger Cancellation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/trigger-cancellation", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","trigger-cancellation"] },
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"reason\": \"Strike action — services suspended.\"\n}" }
          }
        },
        {
          "name": "Step 5 — Trigger Monitoring Cycle (Detect Change)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/monitoring-cycle", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","monitoring-cycle"] }
          }
        },
        {
          "name": "Step 6 — Force Disruption Evaluation",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { var data = pm.response.json().data; if (data && data.disruptionEventId) pm.environment.set('disruptionId', data.disruptionEventId); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/disruption-evaluation", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","disruption-evaluation"] },
            "body": { "mode": "raw", "raw": "{\n  \"journeyId\": {{journeyId}}\n}" }
          }
        },
        {
          "name": "Step 7 — Force Disruption Evaluation Again (Duplicate Guard Check)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/disruption-evaluation", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","disruption-evaluation"] },
            "body": { "mode": "raw", "raw": "{\n  \"journeyId\": {{journeyId}}\n}" }
          }
        },
        {
          "name": "Step 8 — Restore Train to ON_TIME",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/admin/simulation/control/restore-normal", "host": ["{{baseUrl}}"], "path": ["api","admin","simulation","control","restore-normal"] },
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"reason\": \"Signal issue resolved — services resumed.\"\n}" }
          }
        }
